            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_heart_full"
            android:tint="@color/red"
            android:layout_marginStart="370dp"
            android:layout_marginTop="-40dp"
            android:gravity="right"/>





    </LinearLayout>


</FrameLayout>

